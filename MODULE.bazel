############
# Copybara #
############

http_jar = use_repo_rule("@bazel_tools//tools/build_defs/repo:http.bzl", "http_jar")

# The Bazel central registry has an older version of Copybara, but it appears to be
# non-functional: https://github.com/google/copybara/issues/220
# This uses a pre-built version of copybara instead as documented here:
# https://github.com/google/copybara?tab=readme-ov-file#using-pre-built-copybara-in-bazel
http_jar(
    name = "com_github_google_copybara",
    sha256 = "74ca2af1d983a88d060637bfc35d1e32d68922793bc6b1063c4d5b4a57bc0346",
    urls = ["https://github.com/google/copybara/releases/download/v20260727/copybara_deploy.jar"],
)

