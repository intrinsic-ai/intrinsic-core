# Others #
##########

bazel_dep(name = "rules_distroless", version = "0.8.0")

apt = use_extension("@rules_distroless//apt:extensions.bzl", "apt")
apt.install(
    name = "bookworm",
    lock = "//bazel/debian_snapshot:bookworm.lock.json",
    manifest = "//bazel/debian_snapshot:bookworm.yaml",
)
apt.install(
    name = "bullseye_mesa",
    lock = "//bazel/debian_snapshot:bullseye_mesa.lock.json",
    manifest = "//bazel/debian_snapshot:bullseye_mesa.yaml",
)
apt.install(
    name = "weston_chromium",
    lock = "//third_party/chromium:chromium.lock.json",
    manifest = "//third_party/chromium:chromium.yaml",
)
use_repo(apt, "bookworm", "bullseye_mesa", "weston_chromium")

jq_toolchains = use_extension("@jq.bzl//jq:extensions.bzl", "toolchains")
use_repo(jq_toolchains, "jq_toolchains")

register_toolchains("@jq_toolchains//:all")

# Fetch a prebuilt version of Qt 6.8.3 from the distribution CDN. This
# allows us to build OpenCV on linux x86_64 with Qt6 support.
rules_qt_fetch = use_extension("@rules_qt//extension:qt.bzl", "fetch")
use_repo(rules_qt_fetch, "qt_linux_x86_64")

# ffmpeg@7.1.1.bcr.beta.7 depends on opencv@4.13.0.bcr.2, which doesn't have patches
# yet for webp or Qt6. So, we'll force a downgrade until the patches land in the BCR.
single_version_override(
    module_name = "opencv",
    version = "4.12.0.bcr.5",
)

# TODO(b/567681027): Upstream a patch to toybox to use libxcrypt under llvm.
# The patch also adds a bazel_dep on libxcrypt to toybox's own MODULE.bazel,
# so the root module doesn't need to depend on it.
single_version_override(
    module_name = "toybox",
    patch_strip = 1,
    patches = [
        "//third_party/toybox:toybox_dynamic_link.patch",
    ],
    version = "0.8.12.bcr.1",
)



# Use latest commit on `main` to support Bazel 9.
# We need the upstream fixes https://github.com/bazelbuild/rules_license/pull/182 and
# https://github.com/bazelbuild/rules_license/pull/178 but they have not been
# released yet.
# TODO(alexanderfaxa): Remove once a release containing PR #182 and PR #178 is in BCR.
# This was requested on https://github.com/bazelbuild/rules_license/pull/182.
archive_override(
    module_name = "rules_license",
    integrity = "sha256-NNV3jpsOz37HAMQePA0ZUY5IGAEJIgcSNvSNGIUQAa4=",
    strip_prefix = "rules_license-c596de38b2856bf16334ba6e091d6a6a5042bd48",
    urls = [
        "https://github.com/bazelbuild/rules_license/archive/c596de38b2856bf16334ba6e091d6a6a5042bd48.tar.gz",
    ],
)

