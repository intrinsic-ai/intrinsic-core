include "intrinsic/icon/flatbuffers/transform_types.fbs";

namespace intrinsic_fbs;

// Limits for Cartesian trajectory generation at position, velocity,
// acceleration and jerk level. Position limits are translation only as it is
// unclear what rotational position limits mean.
struct CartLimitsPVAJ {
  // Limits for translational component
  max_translational_position:intrinsic_fbs.Point;
  min_translational_position:intrinsic_fbs.Point;
  max_translational_velocity:intrinsic_fbs.Point;
  min_translational_velocity:intrinsic_fbs.Point;
  max_translational_acceleration:intrinsic_fbs.Point;
  min_translational_acceleration:intrinsic_fbs.Point;
  max_translational_jerk:intrinsic_fbs.Point;
  min_translational_jerk:intrinsic_fbs.Point;

  // Limits for Euclidean norm of rotational component.
  max_rotational_velocity:double;
  max_rotational_acceleration:double;
  max_rotational_jerk:double;
}

// Limits for Cartesian trajectory generation at position, acceleration, and
// jerk level. Position limits are translation only as it is unclear what
// rotational position limits mean
struct CartLimitsPAJ {
  // Limits for translational component
  max_translational_position:intrinsic_fbs.Point;
  min_translational_position:intrinsic_fbs.Point;
  max_translational_acceleration:intrinsic_fbs.Point;
  min_translational_acceleration:intrinsic_fbs.Point;
  max_translational_jerk:intrinsic_fbs.Point;
  min_translational_jerk:intrinsic_fbs.Point;

  // Limits for Euclidean norm of rotational component.
  max_rotational_acceleration:double;
  max_rotational_jerk:double;
}

// Limits for joint space trajectory generation at position, velocity,
// acceleration and jerk level.
table JointLimitsPVAJ {
  max_position:intrinsic_fbs.VectorNd;
  min_position:intrinsic_fbs.VectorNd;
  max_velocity:intrinsic_fbs.VectorNd;
  min_velocity:intrinsic_fbs.VectorNd;
  max_acceleration:intrinsic_fbs.VectorNd;
  min_acceleration:intrinsic_fbs.VectorNd;
  max_jerk:intrinsic_fbs.VectorNd;
  min_jerk:intrinsic_fbs.VectorNd;
}

// Limits for joint position, velocity and acceleration.
table JointLimitsPVA {
  max_position:intrinsic_fbs.VectorNd;
  min_position:intrinsic_fbs.VectorNd;
  max_velocity:intrinsic_fbs.VectorNd;
  min_velocity:intrinsic_fbs.VectorNd;
  max_acceleration:intrinsic_fbs.VectorNd;
  min_acceleration:intrinsic_fbs.VectorNd;
}

// Limits for joint space trajectory generation at position, acceleration, and
// jerk level.
table JointLimitsPAJ {
  max_position:intrinsic_fbs.VectorNd;
  min_position:intrinsic_fbs.VectorNd;
  max_acceleration:intrinsic_fbs.VectorNd;
  min_acceleration:intrinsic_fbs.VectorNd;
  max_jerk:intrinsic_fbs.VectorNd;
  min_jerk:intrinsic_fbs.VectorNd;
}

// Limits for joint space trajectory generation at position.
table JointLimitsP {
  max_position:intrinsic_fbs.VectorNd;
  min_position:intrinsic_fbs.VectorNd;
}

