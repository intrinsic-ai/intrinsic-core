# Bundles the _register targets of all Actions that should be available on every ICON server.
cc_library(
    name = "rtcl_controller_default_actions",
    visibility = [
        "//intrinsic_control/intrinsic/icon/cc_client/testing:__subpackages__",
        "//intrinsic_control/intrinsic/icon/control:icon_rtcl",
    ],
    deps = [
        ":adio_action_register",
        ":cartesian_admittance_action_register",
        ":cartesian_impedance_action_register",
        ":empty_action_register",
        ":force_primitive_register",
        ":force_torque_sensor_tare_action_register",
        ":homing_action_register",
        ":joint_impedance_action_register",
        ":joint_jogging_action_register",
        ":rtcl_joint_position_action_register",
        ":rtcl_joint_stop_action_register",
        ":simple_gripper_action_register",
        ":streaming_joint_position_action_register",
        ":trajectory_tracking_action_register",
    ] + [],
    # Force the linker to preserve registration targets, which populate the global
    # RtclActionFactoryRegistry via static initializers at program startup.
    alwayslink = True,
)

