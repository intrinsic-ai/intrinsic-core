id {
  package: "ai.intrinsic"
  name: "dio_wait_for_input"
}
display_name: "DIO wait for input"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description:
    "The `dio _wait_for_input` skill is used to wait for one \n"
    "or more digital input values to change on a Digital \n"
    "Input/Output device.\nThe skill user specifies one or more digital inputs \n"
    "to wait for when the skill is executed.\n\nThe skill will \n"
    "only return when all the specified `indices` in the Digital \n"
    "Input/Output block match the specified `values`.\nOtherwise the skill will return \n"
    "a timeout error.\n"
    ":::note\n"
    "To stop robot motion based on a digital input, \n"
    "consider using the `move_robot` skill with the execution parameters \n"
    "\"move until signal parameters\" instead.\n"
    "The parameterized `move_robot` skill takes immediate effect.\n"
    ":::\n"
}
options {
  supports_cancellation: true
  cc_config {
    create_skill: "::intrinsic::skills::DioWaitForInput::CreateSkill"
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.DioWaitForInputParams"
}
