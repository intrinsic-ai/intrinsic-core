<sdf version='1.6' xmlns:xacro='http://www.ros.org/wiki/xacro'>

  <xacro:macro name="simulation_plugins">

    <!-- HAL Digital IO Block simulation -->
    <plugin filename="static://intrinsic::simulation::DigitalInputOutput" name="DigitalInputOutput">
      <input_block  name="input_block_1"  num_bits="16" />
      <input_block  name="input_block_2"  num_bits="16" />
      <input_block  name="input_block_3"  num_bits="16" />
      <input_block  name="input_block_4"  num_bits="16" />
      <input_block  name="input_block_5"  num_bits="16" />
      <input_block  name="input_block_6"  num_bits="16" />
      <input_block  name="input_block_7"  num_bits="16" />
      <input_block  name="input_block_8"  num_bits="16" />
      <input_block  name="input_block_9"  num_bits="16" />
      <input_block  name="input_block_10" num_bits="16" />
      
      <output_block name="output_block_1"  num_bits="16" />
      <output_block name="output_block_2"  num_bits="16" />
      <output_block name="output_block_3"  num_bits="16" />
      <output_block name="output_block_4"  num_bits="16" />
      <output_block name="output_block_5"  num_bits="16" />
      <output_block name="output_block_6"  num_bits="16" />
      <output_block name="output_block_7"  num_bits="16" />
      <output_block name="output_block_8"  num_bits="16" />
      <output_block name="output_block_9"  num_bits="16" />
      <output_block name="output_block_10" num_bits="16" />
    </plugin>
  </xacro:macro>

</sdf>
