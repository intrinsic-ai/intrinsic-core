updates {
  entity_pose {
    entity_name: "base_link"
    parent_t_this {
      position {
        x: 0.5
        y: 0.5
        z: 0.5
      }
      orientation {
        x: 0
        y: 0
        z: 0
        w: 1
      }
    }
  }
}

updates {
  update_user_data: {
    policy: POLICY_INSERT
    user_data {
      key: "my_key"
      value {
        [type.googleapis.com/google.protobuf.StringValue] {
          value: "my_value"
        }
      }
    }
    user_data {
      key: "struct_key"
      value {
        [type.googleapis.com/google.protobuf.Struct] {
          fields {
            key: "some_flag"
            value {
              bool_value: true
            }
          }
        }
      }
    }
  }
}
