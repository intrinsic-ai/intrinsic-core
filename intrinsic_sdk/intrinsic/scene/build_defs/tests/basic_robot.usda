(
    defaultPrim = "basic_robot"
    metersPerUnit = 1
    upAxis = "Z"
    doc = """A basic robot with a single link that has cube geometry (visual and collision geometry).
"""
)

def Xform "basic_robot" {
    def Xform "base_link" (
        delete apiSchemas = ["PhysicsArticulationRootAPI", "PhysxArticulationAPI"]
        prepend apiSchemas = ["PhysicsRigidBodyAPI", "PhysicsMassAPI"]
    )
    {
        def "visuals" {
            def Cube "cube" {
            }
        }

        def "collisions" {
            def Cube "cube" (
                apiSchemas = ["PhysicsCollisionAPI"]
            )
            {
                uniform token purpose = "guide"
            }
        }
    }
}
