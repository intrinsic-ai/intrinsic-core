"""
Bazel rules for generating an Intrinsic scene object.
"""

load("@com_google_protobuf//bazel/common:proto_info.bzl", "ProtoInfo")
load("//intrinsic_sdk/intrinsic/assets/build_defs:asset.bzl", "AssetInfo", "AssetLocalInfo")
load("//intrinsic_sdk/intrinsic/scene/build_defs:scene_object.bzl", "SceneObjectInfo")
load("//intrinsic_sdk/intrinsic/util/proto/build_defs:descriptor_set.bzl", "ProtoSourceCodeInfo", "gen_source_code_info_descriptor_set")

SceneObjectTypeInfo = provider(
    "provided by intrinsic_scene_object() rule",
    fields = ["bundle_tar"],
)

def _intrinsic_scene_object_impl(ctx):
    bundle_output = ctx.outputs.bundle_out

    inputs = []
    transitive_inputs = []
    geometry_gzfiles = []

    scene_object_info = ctx.attr.scene_object[SceneObjectInfo]
    inputs.append(ctx.file.manifest)
    inputs.append(scene_object_info.gzf)
    geometry_gzfiles.append(scene_object_info.gzf)

    transitive_descriptor_sets = depset(transitive = [
        f[ProtoSourceCodeInfo].transitive_descriptor_sets
        for f in ctx.attr.deps
    ] + [scene_object_info.fdsets])
    transitive_inputs.append(transitive_descriptor_sets)

    args = ctx.actions.args().add(
        "--manifest",
        ctx.file.manifest,
    ).add(
        "--output_bundle",
        bundle_output,
    ).add_all(
        geometry_gzfiles,
        before_each = "--geometry_gzfile",
        uniquify = True,
    ).add_all(
        transitive_descriptor_sets,
        before_each = "--file_descriptor_set",
        uniquify = True,
    )

    ctx.actions.run(
        inputs = depset(inputs, transitive = transitive_inputs),
        outputs = [bundle_output],
        executable = ctx.executable._sceneobjectgen,
        arguments = [args],
        mnemonic = "SceneObjectBundle",
        progress_message = "SceneObject bundle %s" % bundle_output.short_path,
    )

    asset_info_output = ctx.actions.declare_file(ctx.label.name + ".asset_info.binpb")
    local_info_args = ctx.actions.args().add(
        "--manifest",
        ctx.file.manifest,
    ).add(
        "--asset_type",
        "ASSET_TYPE_SCENE_OBJECT",
    ).add_all(
        transitive_descriptor_sets,
        before_each = "--file_descriptor_set",
        uniquify = True,
    ).add(
        "--output_asset_info",
        asset_info_output,
    )
    ctx.actions.run(
        inputs = depset([ctx.file.manifest], transitive = transitive_inputs),
        outputs = [asset_info_output],
        executable = ctx.executable._assetlocalinfogen,
        arguments = [local_info_args],
        mnemonic = "AssetLocalInfo",
        progress_message = "Writing asset info %{output} for %{label}",
    )

    return [
        DefaultInfo(
            executable = bundle_output,
            runfiles = ctx.runfiles(
                transitive_files = depset(inputs, transitive = []),
            ),
        ),
        SceneObjectTypeInfo(
            bundle_tar = bundle_output,
        ),
        AssetInfo(
            asset_info = asset_info_output,
            transitive_descriptor_sets = transitive_descriptor_sets,
        ),
        AssetLocalInfo(
            bundle_path = bundle_output,
        ),
    ]

intrinsic_scene_object = rule(
    implementation = _intrinsic_scene_object_impl,
    attrs = {
        "deps": attr.label_list(
            providers = [ProtoInfo],
            aspects = [gen_source_code_info_descriptor_set],
        ),
        "manifest": attr.label(
            allow_single_file = [".textproto"],
            mandatory = True,
            doc = (
                "A manifest that can be used to provide the scene object metadata."
            ),
        ),
        "scene_object": attr.label(
            providers = [SceneObjectInfo],
            mandatory = True,
            doc = (
                "The geometric description of the asset.  " +
                "This will be generated by the sdf_scene_object rule."
            ),
        ),
        "_assetlocalinfogen": attr.label(
            default = Label("//intrinsic_sdk/intrinsic/assets/build_defs:assetlocalinfogen"),
            cfg = "exec",
            executable = True,
        ),
        "_sceneobjectgen": attr.label(
            default = Label("//intrinsic_sdk/intrinsic/assets/scene_objects/build_defs:sceneobjectgen_main"),
            cfg = "exec",
            executable = True,
        ),
    },
    outputs = {
        "bundle_out": "%{name}.bundle.tar",
    },
    provides = [SceneObjectTypeInfo, AssetInfo, AssetLocalInfo],
)
