metadata {
  id {
    package: "ai.intrinsic"
    name: "calculator_service"
  }
  vendor {
    display_name: "Intrinsic"
  }
  documentation {
    description: "A simple example calculator Service."
  }
  display_name: "Calculator"
}
service_def {
  service_proto_prefixes: "/intrinsic_proto.services.Calculator/"
  config_message_full_name: "intrinsic_proto.services.CalculatorConfig"
  real_spec {
    image {
      archive_filename: "calculator-image.tar"
    }
  }
  sim_spec {
    image {
      archive_filename: "calculator-image.tar"
    }
  }
  recommended_configuration_config {
    source: SOURCE_PLATFORM_DEFAULT
  }
}
