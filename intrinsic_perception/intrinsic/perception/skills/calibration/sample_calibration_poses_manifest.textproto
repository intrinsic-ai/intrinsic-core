id {
  package: "ai.intrinsic"
  name: "sample_calibration_poses"
}
display_name: "Sample calibration poses"
vendor {
  display_name: "Intrinsic"
}
documentation {
  description: 
  "This skill samples waypoints which are to be used for camera\n"
  "calibration, given a specific sampling strategy.\n"
  "\n"
  "The waypoints are sampled as CartesianMotionTarget objects, specifying the\n"
  "3D pose between the frame and the tool object in the world, or as robot\n"
  "joint configurations.\n"
  "\n"
  "The following two cases are supported:\n"
  "  - `CAMERA_SETUP_STATIONARY`: The camera has a fixed position in the workcell\n"
  "  and the calibration object is mounted on the robot's flange.\n"
  "  - `CAMERA_SETUP_MOVING`: The camera is mounted on the robot's flange and the\n"
  "  calibration object is placed in the workcell.\n"
  "\n"
  "This skill returns a `SampleCalibrationPosesResult` which is a repeated\n"
  "`Waypoint` protobuf."
}
options {
  cancellation_ready_timeout {
    seconds: 30
  }
  cc_config {
    create_skill: "::intrinsic::skills::SampleCalibrationPoses::CreateSkill"
  }
}
dependencies {
  required_equipment {
    key: "robot"
    value {
      capability_names: "intrinsic_proto.icon.v1.IconApi"
      capability_names: "Icon2PositionPart"
    }
  }
}
parameter {
  message_full_name: "intrinsic_proto.skills.SampleCalibrationPosesParams"
}
return_type {
  message_full_name: "intrinsic_proto.skills.SampleCalibrationPosesResult"
}
