metadata {
  id {
    package: "ai.intrinsic"
    name: "nvidia_pose_estimator_service"
  }
  vendor {
    display_name: "Intrinsic"
  }
  documentation {
    description: "NVIDIA Pose Estimator Service"
  }
  display_name: "NVIDIA Pose Estimator Service"
}

service_def {
  service_proto_prefixes: "/intrinsic_proto.perception.v1.PoseEstimationService/"
  config_message_full_name: "intrinsic_proto.perception.nvidia.NvidiaPoseEstimatorServiceConfig"
  # Persistent host volume for downloaded weights (/models/weights) and compiled TensorRT plans (/models/engine_cache).
  # LINT.IfChange(real_spec)
  real_spec {
    image {
      archive_filename: "nvidia_pose_estimator_image.tar"
      settings {
        volume_mounts {
          name: "models"
          mount_path: "/models"
        }
        resource_requirements {
          limits {
            key: "nvidia.com/gpu"
            value: "1"
          }
        }
      }
    }
    settings {
      volumes {
        name: "models"
        host_path {
          path: "/var/lib/file-storage/service_volumes/intrinsic/nvidia_pose_estimator"
        }
      }
    }
  }
  # LINT.ThenChange(:sim_spec)

  # Note: the sim spec is the same as the real spec and should be kept in sync.
  # LINT.IfChange(sim_spec)
  sim_spec {
    image {
      archive_filename: "nvidia_pose_estimator_image.tar"
      settings {
        volume_mounts {
          name: "models"
          mount_path: "/models"
        }
        resource_requirements {
          limits {
            key: "nvidia.com/gpu"
            value: "1"
          }
        }
      }
    }
    settings {
      volumes {
        name: "models"
        host_path {
          path: "/var/lib/file-storage/service_volumes/intrinsic/nvidia_pose_estimator"
        }
      }
    }
  }
  # LINT.ThenChange(:real_spec)
}
