"""Macros for packaging perception model weights as Intrinsic Data assets.

Wraps `intrinsic_data` with a generated `DataManifest` carrying an
`intrinsic_proto.perception.v1.PerceptionModel` payload, copying weights from
external repositories into package-relative paths and optionally bundling
staged TensorRT `.plan` files from `@nvidia_pose_estimator_models`.
"""

load("@bazel_skylib//rules:copy_file.bzl", "copy_file")
load("@bazel_skylib//rules:write_file.bzl", "write_file")
load(
    "@nvidia_pose_estimator_models//:files.bzl",
    "PLAN_SUBDIR",
    "SAM3_MISSING_REASON",
    "SAM3_PLANS",
    "SAM3_WEIGHTS",
)
load("//intrinsic_sdk/intrinsic/assets/data/build_defs:data.bzl", "intrinsic_data")

_PERCEPTION_MODEL_PROTO = "@intrinsic_apis//intrinsic/perception/proto/v1:perception_model_proto"

_STAGED_MODELS_REPO = "@nvidia_pose_estimator_models"

_ASSET_PACKAGE = "ai.intrinsic.nvidia_pose_estimator"

def staged_plan_label(filename):
    """Returns the label of a staged TensorRT plan."""
    return "%s//:%s/%s" % (_STAGED_MODELS_REPO, PLAN_SUBDIR, filename)

def _sanitize(path):
    """Turns a runtime-relative path into a fragment usable in a target name."""
    out = ""
    for ch in path.elems():
        out += ch if (ch.isalnum() or ch == "_") else "_"
    return out

def _manifest_content(
        asset_name,
        display_name,
        description,
        vendor,
        version,
        data_dir,
        runtime_paths):
    """Renders the DataManifest textproto."""
    lines = [
        "# Generated by perception_model_data_asset(). Do not edit.",
        "# proto-file: intrinsic/assets/data/proto/v1/data_manifest.proto",
        "# proto-message: intrinsic_proto.data.v1.DataManifest",
        "",
        "metadata {",
        "  id {",
        '    package: "%s"' % _ASSET_PACKAGE,
        '    name: "%s"' % asset_name,
        "  }",
        '  display_name: "%s"' % display_name,
        "  vendor {",
        '    display_name: "%s"' % vendor,
        "  }",
        "  documentation {",
        '    description: "%s"' % description,
        "  }",
        "}",
        "",
        "data {",
        "  [type.googleapis.com/intrinsic_proto.perception.v1.PerceptionModel] {",
        "    one_shot_base_model_config {",
        '      version: "%s"' % version,
        "    }",
    ]
    for runtime_path in runtime_paths:
        lines += [
            "    data_references {",
            # Destination path relative to the service's models root.
            '      key: "%s"' % runtime_path,
            "      value {",
            '        reference: "%s/%s"' % (data_dir, runtime_path),
            "      }",
            "    }",
        ]
    lines += [
        "  }",
        "}",
        "",
    ]
    return lines

def perception_model_data_asset(
        name,
        asset_name,
        display_name,
        description,
        version,
        weights,
        plans = [],
        vendor = "Intrinsic",
        download_setting = None,
        download_flag = None,
        **kwargs):
    """Packages perception model weights and plans into a Data asset bundle.

    Args:
      name: Target name. Produces `<name>.bundle.tar` when enabled.
      asset_name: Asset id name, e.g. "sam3_models". The package is fixed to
        "ai.intrinsic.nvidia_pose_estimator".
      display_name: Human-readable asset name.
      description: Asset documentation string.
      version: Payload version string, recorded in `one_shot_base_model_config`.
      weights: Maps a destination filename relative to the service's models root
        to the label providing it.
      plans: Filenames of staged precompiled TensorRT plans, placed under
        `engine_cache/`.
      vendor: Vendor display name.
      download_setting: Optional `config_setting` label gating `weights`
        downloads. When false, building the asset logs a warning and skips
        building `<name>.bundle.tar`.
      download_flag: Label of the `bool_flag` behind `download_setting`, quoted
        in that warning message. Required when `download_setting` is set.
      **kwargs: Forwarded to `intrinsic_data` (notably `tags` and `visibility`).
    """
    if not weights:
        fail("perception_model_data_asset(%s): `weights` must not be empty" % name)

    files = dict(weights)
    for plan in plans:
        files["engine_cache/" + plan] = staged_plan_label(plan)

    data_dir = "%s_data" % name
    runtime_paths = sorted(files.keys())

    if download_setting and not download_flag:
        fail("perception_model_data_asset(%s): `download_flag` is required with `download_setting`" % name)

    disabled = "%s_weights_disabled" % name
    if download_setting:
        native.genrule(
            name = disabled,
            outs = ["%s_weights_disabled.txt" % name],
            cmd = (
                "echo 'WARNING: %s: model weight downloads are disabled; " % name +
                "skipping bundle build (pass --%s=True to build this asset).' >&2; " % download_flag +
                ": > $@"
            ),
            tags = ["manual"],
        )

    copied = []
    for runtime_path in runtime_paths:
        out = "%s/%s" % (data_dir, runtime_path)
        src = files[runtime_path]
        if download_setting and runtime_path in weights:
            src = select({
                download_setting: src,
                "//conditions:default": ":" + disabled,
            })
        copy_file(
            name = "%s_copy_%s" % (name, _sanitize(runtime_path)),
            src = src,
            out = out,
            allow_symlink = True,
            tags = ["manual"],
        )
        copied.append(out)

    manifest = "%s_manifest.textproto" % name
    write_file(
        name = "%s_manifest" % name,
        out = manifest,
        content = _manifest_content(
            asset_name = asset_name,
            display_name = display_name,
            description = description,
            vendor = vendor,
            version = version,
            data_dir = data_dir,
            runtime_paths = runtime_paths,
        ),
        tags = ["manual"],
    )

    if download_setting:
        bundle_target = "%s_bundle" % name
        intrinsic_data(
            name = bundle_target,
            data = copied,
            manifest = manifest,
            deps = [_PERCEPTION_MODEL_PROTO],
            **kwargs
        )
        copy_file(
            name = "%s_bundle_tar" % name,
            src = ":%s.bundle.tar" % bundle_target,
            out = "%s.bundle.tar" % name,
            allow_symlink = True,
            tags = ["manual"],
        )
        native.alias(
            name = name,
            actual = select({
                download_setting: ":%s_bundle_tar" % name,
                "//conditions:default": ":" + disabled,
            }),
            tags = kwargs.get("tags", ["manual"]),
            visibility = kwargs.get("visibility"),
        )
    else:
        intrinsic_data(
            name = name,
            data = copied,
            manifest = manifest,
            deps = [_PERCEPTION_MODEL_PROTO],
            **kwargs
        )

def sam3_model_data_asset(name, version, **kwargs):
    """Declares the SAM 3 Data asset, or a placeholder warning when unstaged.

    SAM 3 weights are license-gated and must be exported locally via
    `scripts/prepare_sam3_models.sh`. When the staging directory does not hold a
    complete export, building the target logs a warning and skips building the
    bundle.

    Args:
      name: Target name.
      version: Payload version string; see `perception_model_data_asset`.
      **kwargs: Forwarded to `perception_model_data_asset`.
    """
    if not SAM3_WEIGHTS:
        native.genrule(
            name = name,
            outs = ["%s_missing.txt" % name],
            cmd = (
                'echo "WARNING: %s: SAM 3 models are not staged (%s); ' % (name, SAM3_MISSING_REASON) +
                'skipping bundle build (run scripts/prepare_sam3_models.sh to stage them)." >&2; ' +
                ": > $@"
            ),
            tags = ["manual"],
        )
        return

    perception_model_data_asset(
        name = name,
        asset_name = "sam3_models",
        display_name = "SAM 3 models",
        description = (
            "SAM 3 vision/text encoders, box/mask decoders and BPE vocabulary, " +
            "exported to ONNX."
        ),
        version = version,
        weights = {
            filename: "%s//:%s" % (_STAGED_MODELS_REPO, filename)
            for filename in SAM3_WEIGHTS
        },
        plans = SAM3_PLANS,
        tags = ["manual"],
        **kwargs
    )
