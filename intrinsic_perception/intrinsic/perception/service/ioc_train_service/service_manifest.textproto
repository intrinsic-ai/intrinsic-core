metadata {
  id {
    package: "ai.intrinsic"
    name: "ioc_train_service"
  }
  vendor {
    display_name: "Intrinsic"
  }
  documentation {
    description: "Custom training service for the pose estimator used in IOC. The train service takes as input a SceneObject and inference parameters (number of iterations, confidence threshold and visibility threshold) and generates a PoseEstimator data asset."
  }
  display_name: "IOC Train Service"
}

service_def {
  service_proto_prefixes: "/intrinsic_proto.perception.v1.TrainService/"
  config_message_full_name: "intrinsic_proto.perception.ioc.IocTrainServiceConfig"
  real_spec {
    image {
      archive_filename: "ioc_train_service_image.tar"
    }
  }
  sim_spec {
    image {
      archive_filename: "ioc_train_service_image.tar"
    }
  }
}
