load("@bazel_skylib//rules:write_file.bzl", "write_file")
load("@rules_cc//cc:defs.bzl", "cc_binary", "cc_import")
load("@rules_cuda//cuda:defs.bzl", "cuda_library")
load("@rules_python//python:defs.bzl", "py_library")

package(default_visibility = ["//visibility:public"])

licenses(["notice"])  # Apache-2.0

exports_files([
    "LICENSE",
    "THIRD_PARTY_NOTICES.md",
])

py_library(
    name = "foundation_pose_nvidia",
    srcs = glob(["python/src/foundation_pose_nvidia/**/*.py"]),
    imports = ["python/src"],
)

# TensorRT public headers come from the @tensorrt_headers BCR module; nothing is
# pulled from the nvcr.io/nvidia/tensorrt image at build time.
alias(
    name = "tensorrt_headers",
    actual = "@tensorrt_headers//:tensorrt_headers",
)

# Linker stubs for libnvinfer.so.10 and libnvonnxparser.so.10 (resolved at runtime from @tensorrt base image).
write_file(
    name = "nvinfer_stub_src",
    out = "nvinfer_stub.cc",
    content = [
        'extern "C" {',
        "void* createInferBuilder_INTERNAL(void*, int) { return nullptr; }",
        "void* createInferRuntime_INTERNAL(void*, int) { return nullptr; }",
        "}",
    ],
)

cc_binary(
    name = "libnvinfer.so.10",
    srcs = [":nvinfer_stub_src"],
    linkopts = ["-Wl,-soname,libnvinfer.so.10"],
    linkshared = True,
)

cc_import(
    name = "nvinfer_stub",
    shared_library = ":libnvinfer.so.10",
)

write_file(
    name = "nvonnxparser_stub_src",
    out = "nvonnxparser_stub.cc",
    content = [
        'extern "C" {',
        "void* createNvOnnxParser_INTERNAL(void*, void*, int) { return nullptr; }",
        "}",
    ],
)

cc_binary(
    name = "libnvonnxparser.so.10",
    srcs = [":nvonnxparser_stub_src"],
    linkopts = ["-Wl,-soname,libnvonnxparser.so.10"],
    linkshared = True,
)

cc_import(
    name = "nvonnxparser_stub",
    shared_library = ":libnvonnxparser.so.10",
)

cuda_library(
    name = "foundation_pose_cuda",
    srcs = [
        "src/builtin_raster_renderer.cu",
        "src/cuda_pipeline.cu",
        "src/tensorrt_runner.cu",
    ],
    hdrs = glob([
        "include/foundation_pose_nvidia/*.h",
        "include/foundation_pose_nvidia/*.hpp",
        "src/*.cuh",
        "src/*.hpp",
    ]),
    copts = [
        "-DFOUNDATION_POSE_NVIDIA_EXPORTS",
    ],
    includes = [
        "include",
        "src",
    ],
    deps = [
        ":tensorrt_headers",
        "@cuda//:cuda_headers",
    ],
    alwayslink = True,
)

cc_binary(
    name = "libfoundation_pose_nvidia.so.0.1.0",
    srcs = [
        "src/c_api.cpp",
        "src/device_buffer.cpp",
        "src/foundation_pose.cpp",
        "src/mesh.cpp",
        "src/pipeline_utils.cpp",
    ] + glob([
        "include/foundation_pose_nvidia/*.h",
        "include/foundation_pose_nvidia/*.hpp",
        "src/*.hpp",
    ]),
    copts = [
        "-DFOUNDATION_POSE_NVIDIA_EXPORTS",
    ],
    includes = [
        "include",
        "src",
    ],
    linkopts = [
        "-Wl,-soname,libfoundation_pose_nvidia.so.1",
        "-ldl",
    ],
    linkshared = True,
    deps = [
        ":foundation_pose_cuda",
        ":nvinfer_stub",
        ":nvonnxparser_stub",
        ":tensorrt_headers",
        "@cuda//:cuda_runtime_static",
        "@libpng",
    ],
)
