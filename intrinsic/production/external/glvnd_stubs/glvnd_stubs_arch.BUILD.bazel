"""GLVND GL/EGL and host glib system library stubs from an architecture sysroot.

- GLVND stubs are needed to route OpenGL calls to host drivers.
- Glib/GObject/GIO/GModule stubs are needed to link against host
  glib libraries when a target needs access to Qt6.
"""


package(
    default_visibility = [
        "//visibility:public",
    ],
)

alias(
    name = "lock",
    actual = "@{target_name}//:lock",
)

filegroup(
    name = "files",
    srcs = glob(
        [
            # OpenGL and EGL deps
            "usr/lib/*-linux-gnu/libGL.so*",
            "usr/lib/*-linux-gnu/libGLX.so*",
            "usr/lib/*-linux-gnu/libEGL.so*",
            "usr/lib/*-linux-gnu/libGLdispatch.so*",
            "usr/lib/*-linux-gnu/libOpenGL.so*",
            "usr/lib/*-linux-gnu/libX11.so*",
            "usr/lib/*-linux-gnu/libxcb.so*",
            "usr/lib/*-linux-gnu/libXau.so*",
            "usr/lib/*-linux-gnu/libXdmcp.so*",
            "usr/lib/*-linux-gnu/libXext.so*",
            "usr/lib/*-linux-gnu/libbsd.so*",
            "usr/lib/*-linux-gnu/libmd.so*",
        ],
        allow_empty = True,
    ),
)

# buildifier: disable=no-hdrs-no-alwayslink
cc_library(
    name = "glvnd_stubs",
    srcs = [":files"],
)

# We need to compile a dummy empty.cc file into all system glib stubs.
# Bazel's cc_shared_library rule has a strict analysis-phase check that fails
# if a target in its transitive deps contains only precompiled dynamic libraries
# (.so files) with no compiled objects. The dummy empty.cc forces Bazel to compile
# an object file and package it, satisfying the cc_shared_library check.
genrule(
    name = "empty_cc",
    outs = ["empty.cc"],
    cmd = "touch $@",
)

_GLIB_HDRS = glob(
    [
        "usr/include/glib-2.0/**/*.h",
        "usr/lib/*-linux-gnu/glib-2.0/include/**/*.h",
    ],
    allow_empty = True,
)

_GLIB_INCLUDES = [
    "usr/include/glib-2.0",
    "usr/lib/aarch64-linux-gnu/glib-2.0/include",
    "usr/lib/x86_64-linux-gnu/glib-2.0/include",
]

cc_library(
    name = "system_glib",
    srcs = glob(
        [
            "usr/lib/*-linux-gnu/libglib-2.0.so*",
            "lib/*-linux-gnu/libpcre.so.3*",
        ],
        allow_empty = True,
    ) + [":empty_cc"],
    hdrs = _GLIB_HDRS,
    includes = _GLIB_INCLUDES,
)

cc_library(
    name = "system_gobject",
    srcs = glob(
        [
            "usr/lib/*-linux-gnu/libgobject-2.0.so*",
            "usr/lib/*-linux-gnu/libffi.so.7*",
        ],
        allow_empty = True,
    ) + [":empty_cc"],
    hdrs = _GLIB_HDRS,
    includes = _GLIB_INCLUDES,
    deps = [":system_glib"],
)

cc_library(
    name = "system_gio",
    srcs = glob(
        [
            "usr/lib/*-linux-gnu/libgio-2.0.so*",
            "usr/lib/*-linux-gnu/libmount.so.1*",
            "usr/lib/*-linux-gnu/libblkid.so.1*",
            "lib/*-linux-gnu/libselinux.so.1*",
        ],
        allow_empty = True,
    ) + [":empty_cc"],
    hdrs = _GLIB_HDRS + glob(
        ["usr/include/gio-unix-2.0/**/*.h"],
        allow_empty = True,
    ),
    includes = ["usr/include/gio-unix-2.0"] + _GLIB_INCLUDES,
    deps = [
        ":system_glib",
        ":system_gobject",
    ],
)

cc_library(
    name = "system_gmodule",
    srcs = glob(
        ["usr/lib/*-linux-gnu/libgmodule-2.0.so*"],
        allow_empty = True,
    ) + [":empty_cc"],
    hdrs = _GLIB_HDRS,
    includes = _GLIB_INCLUDES,
    deps = [":system_glib"],
)
