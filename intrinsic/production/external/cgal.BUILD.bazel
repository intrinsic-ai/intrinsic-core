"""BUILD file for CGAL."""

load("@rules_cc//cc:defs.bzl", "cc_library")
load("@rules_license//rules:license.bzl", "license")

package(
    default_visibility = ["//visibility:public"],
)

exports_files([
    "LICENSE.md",
    "LICENSES/GPL-3.0-or-later.txt",
    "LICENSES/LGPL-3.0-or-later.txt",
])

license(
    name = "license_lgpl",
    package_name = "cgal",
    license_kinds = [
        "@rules_license//licenses/spdx:LGPL-3.0-or-later",
    ],
    license_text = "LICENSES/LGPL-3.0-or-later.txt",
    package_url = "https://github.com/CGAL/cgal",
)

license(
    name = "license_gpl",
    package_name = "cgal (restricted packages)",
    license_kinds = [
        "@rules_license//licenses/spdx:GPL-3.0-or-later",
    ],
    license_text = "LICENSES/GPL-3.0-or-later.txt",
    package_url = "https://github.com/CGAL/cgal",
)

# Restricted packages from original cgal.BUILD.bazel
RESTRICTED_CGAL_PACKAGES = [
    "Advancing_front_surface_reconstruction",
    "Algebraic_kernel_d",
    "Algebraic_kernel_for_circles",
    "Algebraic_kernel_for_spheres",
    "Alpha_shapes_2",
    "Alpha_shapes_3",
    "Apollonius_graph_2",
    "Arrangement_on_surface_2",
    "Barycentric_coordinates_2",
    "Boolean_set_operations_2",
    "Bounding_volumes",
    "CGAL_ipelets",
    "Circular_kernel_2",
    "Circular_kernel_3",
    "Classification",
    "Combinatorial_map",
    "Convex_hull_d",
    "Envelope_2",
    "Envelope_3",
    "Generalized_map",
    "GraphicsView",
    "Heat_method_3",
    "Hyperbolic_triangulation_2",
    "Inscribed_areas",
    "Interpolation",
    "Interval_skip_list",
    "Jet_fitting_3",
    "Linear_cell_complex",
    "Matrix_search",
    "Minkowski_sum_2",
    "Minkowski_sum_3",
    "Miscellany",
    "Nef_2",
    "Nef_3",
    "Nef_S2",
    "NewKernel_d",
    "OpenNL",
    "Optimal_bounding_box",
    "Optimal_transportation_reconstruction_2",
    "Optimisation_basic",
    "Partition_2",
    "Periodic_2_triangulation_2",
    "Periodic_3_mesh_3",
    "Periodic_3_triangulation_3",
    "Periodic_4_hyperbolic_triangulation_2",
    "Point_set_2",
    "Point_set_3",
    "Point_set_processing_3",
    "Poisson_surface_reconstruction_3",
    "Polygonal_surface_reconstruction",
    "Polyline_simplification_2",
    "Polynomial",
    "Polytope_distance_d",
    "Ridges_3",
    "Scale_space_reconstruction_3",
    "Segment_Delaunay_graph_2",
    "Segment_Delaunay_graph_Linf_2",
    "Set_movable_separability_2",
    "Shape_detection",
    "Skin_surface_3",
    "Snap_rounding_2",
    "Straight_skeleton_2",
    "Stream_lines_2",
    "Surface_mesh_approximation",
    "Surface_mesh_deformation",
    "Surface_mesh_parameterization",
    "Surface_mesh_segmentation",
    "Surface_mesh_shortest_path",
    "Surface_mesh_skeletonization",
    "Surface_mesh_topology",
    "Tetrahedral_remeshing",
    "Three",
    "Triangulation",
    "Visibility_2",
    "Voronoi_diagram_2",
]

cc_library(
    name = "cgal",
    hdrs = glob(
        [
            "*/include/**/*.h",
            "*/include/**/*.hpp",
        ],
        allow_empty = True,
        exclude = ["%s/**" % x for x in RESTRICTED_CGAL_PACKAGES],
    ),
    applicable_licenses = [":license_lgpl"],
    defines = [
        "CGAL_USE_CORE",
        "CGAL_HEADER_ONLY",
        "CGAL_EIGEN3_ENABLED",
        "CGAL_USE_OPENMESH",
        "CGAL_DISABLE_GMP",
        "CGAL_DISABLE_MPFR",
        "CGAL_LINKED_WITH_TBB",
        "CGAL_NO_DEPRECATION_WARNINGS",
        "CGAL_NO_GDB_AUTOLOAD",
    ],
    # Dynamically find all include directories for non-restricted packages
    includes = glob(
        ["*/include"],
        exclude = ["%s/**" % x for x in RESTRICTED_CGAL_PACKAGES],
        exclude_directories = 0,
    ),
    textual_hdrs = glob(
        [
            "*/include/**/*.inc",
            "*/include/**/*.tcc",
        ],
        allow_empty = True,
        exclude = ["%s/**" % x for x in RESTRICTED_CGAL_PACKAGES],
    ),
    deps = [
        "@boost.format",
        "@boost.functional",
        "@boost.graph",
        "@boost.heap",
        "@boost.iterator",
        "@boost.logic",
        "@boost.multiprecision",
        "@com_gitlab_libeigen_eigen//:eigen",
        "@onetbb//:tbb",
        "@openmesh",
    ],
)

cc_library(
    name = "cgal_restricted",
    hdrs = glob(
        ["%s/include/**/*.h" % x for x in RESTRICTED_CGAL_PACKAGES] +
        ["%s/include/**/*.hpp" % x for x in RESTRICTED_CGAL_PACKAGES],
        allow_empty = True,
    ),
    applicable_licenses = [":license_gpl"],
    includes = glob(
        ["%s/include" % x for x in RESTRICTED_CGAL_PACKAGES],
        allow_empty = True,
        exclude_directories = 0,
    ),
    textual_hdrs = glob(
        ["%s/include/**/*.inc" % x for x in RESTRICTED_CGAL_PACKAGES] +
        ["%s/include/**/*.tcc" % x for x in RESTRICTED_CGAL_PACKAGES],
        allow_empty = True,
    ),
    visibility = ["//visibility:public"],
    deps = [":cgal"],
)
