load("@rules_cc//cc:cc_library.bzl", "cc_library")
load("@rules_cc//cc:cc_test.bzl", "cc_test")

# Package to allow computing robot model corrections based on the kinematic calibration values for
# UR robots
load("@rules_license//rules:license.bzl", "license")

package(
    default_applicable_licenses = [":license"],
    default_visibility = ["//visibility:public"],
)

exports_files([
    "package.xml",
    "src/calibration.cpp",
    "include/ur_calibration/calibration.hpp",
])

license(
    name = "license",
    package_name = "universal-robots-client-library",
    license_kinds = [
        "@rules_license//licenses/spdx:BSD-3-Clause",
    ],
    license_text = "package.xml",
)

cc_library(
    name = "calibration",
    srcs = ["src/calibration.cpp"],
    hdrs = ["include/ur_calibration/calibration.hpp"],
    includes = ["include"],
    deps = [
        "@abseil-cpp//absl/log",
        "@com_gitlab_libeigen_eigen//:eigen",
        "@rclcpp//:rclcpp_library",
        "@yaml-cpp//:yaml-cpp",
    ],
)

cc_test(
    name = "calibration_test",
    srcs = ["test/calibration_test.cpp"],
    includes = ["include"],
    deps = [
        ":calibration",
        "@com_google_googletest//:gtest_main",
    ],
)
