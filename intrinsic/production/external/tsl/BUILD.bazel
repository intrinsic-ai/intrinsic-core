load("@rules_cc//cc:cc_library.bzl", "cc_library")

package(default_visibility = ["//visibility:public"])

# buildifier: disable=external-path
copy_and_rename = "\n".join([
    "cp $< $@",
    "sed -i 's/TENSORFLOW_TSL_PLATFORM_NET_H_/INTRINSIC_PRODUCTION_EXTERNAL_TSL_NET_H_/g' $@",
    "sed -i 's/#include \"tsl\\/platform\\/net.h\"/#include \"intrinsic\\/production\\/external\\/tsl\\/net.h\"/g' $@",
    "sed -i 's/#include \"xla\\/tsl\\/platform\\/logging.h\"/#include \"absl\\/log\\/check.h\"\\n#include \"absl\\/log\\/log.h\"/g' $@",
])

genrule(
    name = "net_h",
    srcs = ["@com_github_openxla_xla_tsl_net_h//file"],
    outs = ["net.h"],
    cmd = copy_and_rename,
    visibility = ["//visibility:public"],
)

genrule(
    name = "net_cc",
    srcs = ["@com_github_openxla_xla_tsl_net_cc//file"],
    outs = ["net.cc"],
    cmd = copy_and_rename,
    visibility = ["//visibility:public"],
)

cc_library(
    name = "net",
    srcs = [":net.cc"],
    hdrs = [":net.h"],
    deps = [
        "@abseil-cpp//absl/base:core_headers",
        "@abseil-cpp//absl/log",
        "@abseil-cpp//absl/log:check",
        "@abseil-cpp//absl/strings",
        "@abseil-cpp//absl/synchronization",
    ],
)
