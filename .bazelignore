# dev_tools is not using bazel
external/dev_tools/

# separate modules
intrinsic_apis/intrinsic/
sdk-examples/
developer_resources/docs/generators/grpc/

# do not run bazel for local node_modules directories
developer_resources/docs/node_modules/
node_modules/

# os not using bazel
os/

# BUG: when switching --output_base subsequent builds might fail as this symlink is pointing to the old build.
# See https://github.com/bazelbuild/bazel/issues/10653#issuecomment-694230015.
# This might be fixed in Bazel 7.1.0.
bazel-insrc

# BUG: The .pnpm-store directory contains circular symlinks which cause the Bazel loader to hang or crash during package loading.
.cache
# BUG: The .cache directory often contains tool-generated metadata that Bazel misinterprets as "phantom" packages or invalid labels, triggering "Exit Status 7" crashes.
.pnpm-store

# Relocated intrinsic APIs Bzlmod module
intrinsic_apis/node_modules
