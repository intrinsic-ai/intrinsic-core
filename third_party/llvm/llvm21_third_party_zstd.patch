diff --git a/3rd_party/llvm-project/21.x/patches/llvm-compression-defines.patch b/3rd_party/llvm-project/21.x/patches/llvm-compression-defines.patch
--- a/3rd_party/llvm-project/21.x/patches/llvm-compression-defines.patch
+++ b/3rd_party/llvm-project/21.x/patches/llvm-compression-defines.patch
@@ -1,17 +1,52 @@
 diff --git a/llvm/BUILD.bazel b/llvm/BUILD.bazel
 --- a/llvm/BUILD.bazel
 +++ b/llvm/BUILD.bazel
-@@ -386,8 +386,12 @@ cc_library(
+@@ -386,8 +386,16 @@ cc_library(
              "BLAKE3_NO_AVX512",
              "BLAKE3_NO_SSE2",
              "BLAKE3_NO_SSE41",
          ],
 -    }),
 +    }) + [
 +        "LLVM_ENABLE_ZLIB=1",
